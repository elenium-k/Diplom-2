# Дополнительные игнорируемые папки (если они не нужны в репозитории)
.target/
.mvn/
.allure/

# ВАЖНОЕ ИЗМЕНЕНИЕ ДЛЯ ALLURE
# Разрешаем просмотр папки target (но не её содержимого)
!target/
# Разрешаем просмотр содержимого target (чтобы Git мог «увидеть» подпапки)
!target/*
# Явно разрешаем папку allure-results внутри target
!target/allure-results/
# Дополнительно: разрешаем всё содержимое allure-results
!target/allure-results/*
